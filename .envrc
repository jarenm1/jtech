use flake

# Per-workspace cargo target dir. Do NOT share one target dir across jj
# workspaces — cargo keys path deps by crate name, not directory, so sibling
# workspaces with divergent code overwrite each other's artifacts (observed:
# phantom stale-API compile errors, verified 2026-09-28). Per-workspace dirs
# cost one cold dep build each (~3min with warm registry) and are correct.
export CARGO_TARGET_DIR="$PWD/target"

# Optional untracked local overrides (gitignored).
source_env_if_exists .envrc.local

# Local environment
.direnv/
.envrc.local
.env
.env.*
!.env.example

# Rust
# No trailing slash: `target` is a symlink into ~/workspaces/.targets, and a
# trailing slash only matches real directories. See AGENTS.md, "Workspace
# isolation".
/target

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build outputs
/build/
/dist/
/result
/result-*
